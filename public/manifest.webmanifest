{
  "name": "PaperRaj",
  "short_name": "PaperRaj",
  "description": "The place to find and share school question papers.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#f2e9d8",
  "theme_color": "#553a22",
  "lang": "en",
  "dir": "ltr",
  "categories": ["education", "productivity", "books"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Browse papers",
      "url": "/papers",
      "description": "Open the library catalogue"
    },
    {
      "name": "Upload a paper",
      "url": "/upload",
      "description": "Add a paper to the archive"
    },
    {
      "name": "My uploads",
      "url": "/my-uploads",
      "description": "Manage the papers you contributed"
    }
  ]
}
