# ============================================================================
# PaperRaj — environment variables
# Copy to `.env.local` for local development, and add to Render for production.
#
#  PUBLIC  → safe to expose to the browser (NEXT_PUBLIC_* prefix)
#  PRIVATE → server-side only. NEVER commit real values, and never put these
#            in a NEXT_PUBLIC_* variable or in client code.
# ============================================================================

# --------------------------------------------------------------- REQUIRED ---
# PostgreSQL / Supabase connection string.
# Supabase → Project Settings → Database → Connection string → URI
# Use the *session pooler* URI (port 5432 works, 6543 is the transaction pooler)
# and replace [YOUR-PASSWORD] with the database password you chose.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.abcdefgh.supabase.co:5432/postgres

# Public URL of the deployed site. Used for SEO metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------- SUPABASE (RECOMMENDED) ---
# Project Settings → API
# SUPABASE_URL and SUPABASE_ANON_KEY power authentication.
SUPABASE_URL=https://abcdefgh.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# ⚠ SECRET — server-side only. Never expose this to the browser, never commit it.
# Required for Supabase Storage uploads and signed download URLs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket that holds the actual PDFs and images (must be private).
SUPABASE_STORAGE_BUCKET=paperraj-papers

# ----------------------------------------------------------- ADMINISTRATION ---
# The account created with this email address automatically becomes the
# librarian (administrator). Set it BEFORE you create your admin account.
ADMIN_EMAIL=you@gmail.com

# ------------------------------------------------------------ OPTIONAL -----
# Branding / contact links (single source of truth for the UI).
PUBLIC_OWNER_EMAIL=you@gmail.com
PUBLIC_YOUTUBE_URL=https://www.youtube.com/@yourchannel
PUBLIC_OWNER_NAME=Your Name

# Default maximum upload size in megabytes. Can be changed at any time from
# the librarian's desk (Settings) without redeploying. Hard ceiling: 200 MB.
MAX_UPLOAD_MB=50

# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT WITHOUT SUPABASE
# ---------------------------------------------------------------------------
# The app runs entirely on a local PostgreSQL database if the Supabase
# variables above are left empty: authentication uses a built-in scrypt-based
# provider and uploaded files are stored in the `file_blobs` table. Add Supabase
# credentials whenever you are ready — nothing else has to change.
